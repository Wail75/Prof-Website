% layout 'default';
% title l('Dashboard');

<div class="container">

%= include 'common/_connected_top_bar'

<h1><%=l('Dashboard')%></h1>

%= include 'common/_notifications'

<div class="row">
  <h2 id="author"><%= link_to author_index => begin %><%=l('Quiz Authoring')%><%end%></h2>
  <%= link_to author_index => begin %><%=l('Click here to create and edit quizzes.')%><%end%>
</div>

<div class="row">
  %= include 'common/_do_quiz'
</div>

<div class="row">
  % if ($quizs) {
      %= form_for 'dashboard', method => 'POST' => begin
          %= csrf_field
          %= label_for selected_quiz => l('Select the quiz you want to do')
          %# prepare a list of selection options quiz_name => quiz id, with the session selected quiz if any
          %= select_field selected_quiz => [map {[$_->{name} => $_->{id}, ( $selected_quiz_name && $selected_quiz_name eq $_->{name} ? ('selected' => '') : ()) ]} @$quizs], id => 'selected_quiz'
          %= submit_button l('Select')
      %= end
  % }
</div>

</div>
