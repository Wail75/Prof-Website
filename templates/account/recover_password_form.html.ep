% layout 'default';
% title l('Recover your password');

<h1><%=l 'Recover your password' %></h1>

%= include 'common/_notifications'

<p><%= l('Enter your email address and, if it is recognized, you will receive a link that ' .
    'will allow you to reset your password.') %></p>

% my $recover_password_errors = flash('recover_password_errors') || {};
%= form_for recover_password => begin
    %= csrf_field
<p id="recover-password">
    %= label_for 'email' => begin
        <%=l 'Your email address:' %>
        % if ( my $e = $recover_password_errors->{'email'} ) {
        <b id="error-email" class="error">
            %= l('You must give an email address.') if $e->[0] eq 'required'
            %= l('The syntax of the email is not valid.') if $e->[0] eq 'email_syntax'
        </b>
        % }
    % end
    <%= email_field 'email' %>

    <%= submit_button l('Send') %>
</p>
% end

<p><%= link_to index => begin %> <%=l('Index')%><%end%></p>
