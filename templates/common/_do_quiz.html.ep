%# required variables: $page_source $selected_quiz_name $item_id $question
%# required to show correct answers $last_response_quiz_type
%# expects flash or session variable 'response_msg' to show if the response to quiz is correct or not

% if ($selected_quiz_name) {

<h3 id="quiz-name"><%=l('Quiz: ') . $selected_quiz_name%></h3>

% if ($selected_quiz_average_grade) {
  <p><%=l('Your average score for this quiz:')%> <%=$selected_quiz_average_grade%>%.</p>
% }

    % if ($last_response_quiz_type && $last_response_quiz_type eq 'whole-quiz') {
      %= include 'common/_response_result'
    % }

    % if ($item_id) {

<p id='question-asked'><%=l('Question:') . ' '%><span id="question" class="question"><%=$question%></span> (<%= defined $average_grade ? l('your average score:') . " $average_grade%" : l('no answer yet')%>)</p>
<p><%=l('Your answer')%></p>
<p>
%= form_for 'respond_question' => begin
    %= csrf_field
    %= hidden_field page_source => $page_source
    %= hidden_field quiz_type => 'whole-quiz'
    %= hidden_field item_id => $item_id
    %= text_area 'response', cols => 40, rows => 3, class => 'large-text', autofocus => '', autocomplete => 'off'
    %= submit_button l('Send')
%= end
</p>

    % } else {

<p id="do-quiz-no-item"><%=l('No item for this quiz.')%></p>

    % }

% } elsif (@$quizs) {
<p id="do-quiz-no-item"><%=l('No item for this quiz.')%></p>
% } else {
<p id="do-quiz-no-quiz"><%=l('No quiz found.')%> <%=l('Start by authoring one.')%></p>
% }
